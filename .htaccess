# ========================================
# NotyCaption Pro - Apache Rewrite Rules
# For: notycaptiongen.free.nf
# ========================================

RewriteEngine On
RewriteBase /

# Don't rewrite real files
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Don't rewrite real directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Don't rewrite files with extensions
RewriteCond %{REQUEST_URI} \.[a-zA-Z0-9]{2,5}$
RewriteRule ^ - [L]

# Route /app to app.html
RewriteRule ^app/?$ app.html [L]

# Route everything else to index.html
RewriteRule ^(.*)$ index.html [L,QSA]

Options -Indexes

# Cache static assets
<FilesMatch "\.(ico|png|jpg|jpeg|gif|css|js|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

# No cache for notebooks and JSON
<FilesMatch "\.(ipynb|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>
